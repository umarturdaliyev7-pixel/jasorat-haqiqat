PORT=3001
# PostgreSQL connection string. Without it, results are not persisted.
DATABASE_URL=
# Only needed when frontend is hosted on a different origin:
CLIENT_ORIGIN=
# Admin login is disabled until a strong password is set (12+ characters).
ADMIN_PASSWORD=
# Long random secret for admin session signing; set once in production.
ADMIN_SECRET=
# Production: mount a persistent volume at /data and set DATA_DIR=/data.
DATA_DIR=./data
